# ==============================================================================
# MoleWatch Deployment Environment Template
# Copy this file to '.env' and replace the placeholder values with your GCP setup.
# REMEMBER Do NOT commit your populated '.env' file to Git!
# ==============================================================================


IMAGE=molewatch-api
# fill GCP_PROJECT accordingly
GCP_PROJECT=your-gcp-project-id
GCP_REGION=europe-west1
# fill ARTIFACTSREPO accordingly
ARTIFACTSREPO=your-artifact-repo
MEMORY=2Gi
